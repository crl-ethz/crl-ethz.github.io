  journal={physics-informed-modeling, deformable-objects, task-and-motion-planning, simulation},
  year={2025},
  pdf={2025_phystwin-video-deformable-tamp.pdf},
  abstract={Robotic task and motion planning (TAMP) for deformable objects typically relies on predefined physics models, limiting the robot's adaptability in real-world scenarios. This project explores how robots can autonomously construct physics-informed digital twins directly from videos and integrate the learned physics model into a TAMP framework to achieve "on-demand" manipulation of deformable objects.},
  website={/phystwin-video-deformable-tamp/},
  preview={2025_phystwin-video-deformable-tamp.png},
  selected={true},
}
